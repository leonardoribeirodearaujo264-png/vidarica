# ══════════════════════════════════════════════════════════════════
# Meta Pixel + Conversions API
# Copie para .env.local no desenvolvimento e cadastre na Vercel em
# Settings > Environment Variables. NUNCA commitar valores reais de
# token: .env* esta no .gitignore.
# ══════════════════════════════════════════════════════════════════

# ID do Pixel usado no navegador (publico — aparece no HTML)
NEXT_PUBLIC_META_PIXEL_ID=1675957073477718

# Mesmo ID, usado pelo servidor na Conversions API
META_PIXEL_ID=1675957073477718

# SEGREDO — token da Conversions API. So no servidor.
META_CONVERSIONS_API_TOKEN=

# Opcional — codigo do "Testar eventos" do Gerenciador de Eventos.
# Enquanto preenchido, os eventos vao para a aba de teste e nao para os
# dados reais. Deixe VAZIO em producao.
META_TEST_EVENT_CODE=

# Opcional — versao da Graph API (padrao: v24.0)
META_GRAPH_API_VERSION=
